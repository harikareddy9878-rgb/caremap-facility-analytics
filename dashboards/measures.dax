Total Facilities = COUNTROWS('Facilities')

State Count = DISTINCTCOUNT('Facilities'[state])

District Count = DISTINCTCOUNT('Facilities'[district])

Mapped Facilities =
CALCULATE(
    [Total Facilities],
    NOT ISBLANK('Facilities'[latitude]),
    NOT ISBLANK('Facilities'[longitude])
)

Mapped Percentage = DIVIDE([Mapped Facilities], [Total Facilities], 0)

Average Completeness = AVERAGE('Facilities'[record_completeness_pct])

Public Facilities =
CALCULATE(
    [Total Facilities],
    CONTAINSSTRING(LOWER('Facilities'[ownership_type]), "public")
)

Public Facility Percentage = DIVIDE([Public Facilities], [Total Facilities], 0)
